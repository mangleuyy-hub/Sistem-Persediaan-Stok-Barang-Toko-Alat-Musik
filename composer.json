{
  "name": "musik/stok-alat-musik",
  "description": "Sistem Persediaan Stok Barang Toko Alat Musik berbasis CodeIgniter 4.",
  "type": "project",
  "require": {
    "php": "^8.1",
    "codeigniter4/framework": "^4.5",
    "dompdf/dompdf": "^3.0",
    "phpoffice/phpspreadsheet": "^2.2"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-update-cmd": [
      "CodeIgniter\\ComposerScripts::postUpdate"
    ],
    "serve": "php spark serve"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.2.12"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
